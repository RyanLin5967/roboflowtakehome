# Example configuration only. Do not put real keys in this repository.
COUNTERPART_DATABASE_URL=postgresql:///counterpart_dev
COUNTERPART_MEDIA_DIR=var/media
COUNTERPART_LIVE_ENABLED=false
COUNTERPART_INFERENCE_LIMIT=128
COUNTERPART_EXPORT_ENABLED=false
# Configure only an existing destination after validating its privacy/permissions.
COUNTERPART_EXPORT_PROJECT=
# Version generation has a separate lifetime reservation cap; keep disabled
# until current provider credits and no-cash billing controls are verified.
COUNTERPART_ROBOFLOW_GENERATION_LIMIT=0
COUNTERPART_ROBOFLOW_GENERATION_BUDGET_EVIDENCE=
