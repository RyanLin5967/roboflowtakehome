{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadEvidenceOnly",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::REPLACE_BUCKET/counterpart/media/*"
    },
    {
      "Sid": "CreateConditionalEvidenceOnly",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::REPLACE_BUCKET/counterpart/media/*",
      "Condition": {"Null": {"s3:if-none-match": "false"}}
    },
    {
      "Sid": "RefuseUnconditionalReplacement",
      "Effect": "Deny",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::REPLACE_BUCKET/counterpart/media/*",
      "Condition": {"Null": {"s3:if-none-match": "true"}}
    },
    {
      "Sid": "RuntimeCannotDeleteEvidence",
      "Effect": "Deny",
      "Action": ["s3:DeleteObject", "s3:DeleteObjectVersion"],
      "Resource": "arn:aws:s3:::REPLACE_BUCKET/counterpart/media/*"
    }
  ]
}
